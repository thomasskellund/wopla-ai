{
  "name": "wopla-ai",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @wopla-ai/web dev",
    "build": "pnpm --filter @wopla-ai/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset && supabase test db",
    "db:types": "supabase gen types typescript --local --schema public --schema api > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.115.0"
  }
}
