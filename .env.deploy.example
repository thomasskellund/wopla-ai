# Copy to .env (gitignored) next to docker-compose.yml on the deploy host.
# Real values are environment-specific and never committed.

# Public Supabase URL/key this build should point at (baked into the client
# bundle at BUILD time — see the Dockerfile's own header comment).
VITE_SUPABASE_URL=https://supabase-ai.heyrobot.com
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://wopla-ai.heyrobot.com

# See docker-compose.yml's extra_hosts comment for why this exists.
SUPABASE_HAIRPIN_HOST=supabase-ai.heyrobot.com
SUPABASE_HAIRPIN_IP=172.17.0.1
